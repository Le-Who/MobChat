{
	"schemaVersion": 1,
	"id": "creaturechat",
	"version": "${version}",
	"name": "CreatureChat",
	"description": "Chat, befriend, and interact with a rich world of creatures like never before! All creatures can talk and respond naturally using AI.",
	"authors": [
		"MobChat maintainers",
		"Original CreatureChat authors"
	],
	"contact": {
		"sources": "https://github.com/Le-Who/MobChat"
	},
	"license": "GPLv3",
	"icon": "assets/creaturechat/icon.png",
	"environment": "*",
    "entrypoints": {
        "main": [
          "com.lewho.ModInit"
        ],
        "client": [
          "com.lewho.ClientInit"
        ],
        "fabric-datagen": [
          "com.lewho.datagen.CreatureChatDataGenerator"
        ]
    },
	"mixins": [
		"creaturechat.mixins.json",
		{
			"config": "creaturechat.client.mixins.json",
			"environment": "client"
		}
	],
	"accessWidener": "creaturechat.accesswidener",
	"depends": {
		"fabricloader": ">=0.15.6",
		"minecraft": "~${minecraft_version}",
		"java": ">=17",
		"fabric-api": "*"
	}
}
